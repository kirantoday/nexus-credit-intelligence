# Backend environment variables (PLAN.md section 19).
# Copy this file to backend/.env for local development — never commit the copy.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Supabase / database.
#
# This Supabase project is shared with another application. Nexus is isolated
# entirely inside the `nexus` Postgres schema (tables, indexes, sequences, the
# Alembic version table) — it never reads, writes, or migrates anything in
# `public` or any other schema. DATABASE_URL is the pooled connection used by
# the running app; DIRECT_DATABASE_URL is the non-pooled connection required
# by Alembic (Supabase Dashboard > Connect > "Direct connection").
DATABASE_URL=
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Bucket must be created manually in Supabase Storage as private; do not reuse
# the other application's bucket. Suggested name: nexus-private-documents.
SUPABASE_STORAGE_BUCKET=

# Public data providers
SEC_USER_AGENT=
FRED_API_KEY=
OPENFIGI_API_KEY=
COURTLISTENER_API_TOKEN=

# FINRA TRACE (marketplace OAuth2 — real flow, unused in demo path)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# PACER — inactive/optional, see PLAN.md section 15. Never required to boot the app.
PACER_USERNAME=
PACER_PASSWORD=
PACER_ENABLED=false

# Disabled/licensed providers — interfaces only
SP_GLOBAL_ENABLED=false
OCTUS_ENABLED=false
BLOOMBERG_ENABLED=false
LSEG_LPC_ENABLED=false

# AI / LLM gate (Milestone 6.5, PLAN.md section 24.7). Provider-specific
# credentials, never a shared generic secret — the factory validates only
# LLM_PROVIDER's own required fields and never silently falls back to
# another provider.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
# Document embeddings (Milestone 10D.2, ADR-021). OFF by default. Providers:
# `fake` (deterministic, meaningless vectors; ENVIRONMENT local or test only)
# and `openai` (text-embedding-3-large at 1024 dimensions; approved for LOCAL
# DEVELOPMENT only -- no external processing, key, paid usage or production
# use is authorized by listing it here). EMBEDDING_DIMENSION must equal the
# embedding column width (1024) -- a contract, not a free setting.
# For `openai` ALL of the following are required, otherwise construction
# fails closed before any client exists: EMBEDDING_MODEL_VERSION (a Nexus
# label, not a vendor snapshot), a DEDICATED EMBEDDING_API_KEY (never
# OPENAI_API_KEY, which is the LLM's key and is never used for embeddings),
# and EMBEDDING_EXTERNAL_POLICY_APPROVAL=openai:text-embedding-3-large, the
# owner's explicit acknowledgement, plus EMBEDDING_POLICY_REFERENCE, an identifier or
# content hash of the owner-accepted policy record (observed and audited, never verified by
# the application). Leave all of these blank until approved.
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL_ID=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_JOB_MAX_ATTEMPTS=3
EMBEDDING_STALE_PROCESSING_AFTER_SECONDS=900
EMBEDDING_API_KEY=
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_EXTERNAL_POLICY_APPROVAL=
EMBEDDING_POLICY_REFERENCE=

# Auth (disabled for first demo; architecture supports Supabase Auth JWT later)
AUTH_ENABLED=false

# Web/CORS
#
# CORS_ALLOWED_ORIGINS is a comma-separated list of exact origins (scheme +
# host + optional port, no path, no trailing slash) — never a wildcard.
# Local dev needs both localhost and 127.0.0.1 (browsers treat them as
# distinct origins). Production (Railway) sets this to the deployed Vercel
# origin, e.g.:
#   CORS_ALLOWED_ORIGINS=https://nexus-credit-intelligence.vercel.app
# Multiple origins (e.g. a preview deployment alongside production) are
# comma-separated in one value.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
