# Backend environment variables (PLAN.md section 19).
# Copy this file to backend/.env for local development — never commit the copy.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Supabase / database.
#
# This Supabase project is shared with another application. Nexus is isolated
# entirely inside the `nexus` Postgres schema (tables, indexes, sequences, the
# Alembic version table) — it never reads, writes, or migrates anything in
# `public` or any other schema. DATABASE_URL is the pooled connection used by
# the running app; DIRECT_DATABASE_URL is the non-pooled connection required
# by Alembic (Supabase Dashboard > Connect > "Direct connection").
DATABASE_URL=
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Bucket must be created manually in Supabase Storage as private; do not reuse
# the other application's bucket. Suggested name: nexus-private-documents.
SUPABASE_STORAGE_BUCKET=

# Public data providers
SEC_USER_AGENT=
FRED_API_KEY=
OPENFIGI_API_KEY=
COURTLISTENER_API_TOKEN=

# FINRA TRACE (marketplace OAuth2 — real flow, unused in demo path)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=

# PACER — inactive/optional, see PLAN.md section 15. Never required to boot the app.
PACER_USERNAME=
PACER_PASSWORD=
PACER_ENABLED=false

# Disabled/licensed providers — interfaces only
SP_GLOBAL_ENABLED=false
OCTUS_ENABLED=false
BLOOMBERG_ENABLED=false
LSEG_LPC_ENABLED=false

# AI / LLM gate
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Auth (disabled for first demo; architecture supports Supabase Auth JWT later)
AUTH_ENABLED=false

# Web/CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
